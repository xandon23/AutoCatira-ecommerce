{
  "name": "autocatira-notification-service",
  "version": "1.0.0",
  "description": "Microsserviço de notificações do AutoCatira: consome eventos do Redis, valida usuários na API principal e grava notificações em banco próprio.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.5",
    "redis": "^6.3.1",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "typescript": "^5.9.3"
  }
}
